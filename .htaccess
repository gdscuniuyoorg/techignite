# ── SPA Fallback ──────────────────────────────────────────────────────────
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Real files (JS, CSS, images) are served as they are.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # The admin app is a single client-rendered shell. Every /admin/* URL uses
  # the prerendered shell so production never falls back to the public landing
  # page; the router resolves the child route after hydration.
  RewriteRule ^admin(/.*)?$ /admin/index.html [L]

  # Pre-rendered routes live in folders (auth/index.html, dashboard/index.html).
  # DirectorySlash Off stops Apache from resolving /auth to /auth/ on its own,
  # so serve the folder's index.html explicitly. Without this, every route
  # falls through to the landing page and briefly shows the public navbar and
  # footer before hydration.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*?)/?$ /$1/index.html [L]

  # Dynamic invite links (/team/<id>/onboarding?token=…) reuse the prerendered
  # chromeless onboarding shell until the router hydrates the real invite.
  RewriteRule ^team/[^/]+/onboarding/?$ /team/invite/onboarding/index.html [L]

  # Missing files under /assets return a real 404 instead of the app shell.
  RewriteRule ^assets/ - [R=404,L]

  # Everything else, including folder-named routes, goes to the SPA.
  RewriteRule ^ /index.html [L]
</IfModule>

# ── Compression ───────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Cache Control ─────────────────────────────────────────────────────────
# Hashed assets (JS/CSS from Vite) can be cached aggressively.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType image/webp                "access plus 1 month"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/font-woff2    "access plus 1 year"

  # HTML must revalidate so users always get the latest entry point.
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

# ── Security Headers ─────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Generated files must carry explicit charsets (spec 0002, AC-3..5).
  <FilesMatch "^sitemap\.xml$">
    Header set Content-Type "application/xml; charset=utf-8"
  </FilesMatch>
  <FilesMatch "^(robots|llms)\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
  </FilesMatch>
</IfModule>